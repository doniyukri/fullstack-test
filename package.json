{
  "name": "submission",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "nuxt build",
    "typecheck": "nuxt typecheck",
    "test:e2e": "playwright test",
    "format": "prettier --write app server shared scripts tests checks e2e nuxt.config.ts playwright.config.ts compose.yaml README.md",
    "check:history": "node --env-file=.env scripts/check-history-outage.mjs",
    "dev": "nuxt dev",
    "test": "node --test",
    "seed": "node --env-file=.env scripts/seed.ts",
    "seed:reviewers": "node --env-file=.env scripts/seed-reviewers.ts",
    "check:db": "node --env-file=.env --test checks/*.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@lucide/vue": "^1.73.0",
    "mongodb": "^6.22.0",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "readdir-glob": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  }
}
